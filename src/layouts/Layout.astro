---
// src/layouts/Layout.astro
import Header from "@components/Header.astro";
import Footer from "@components/Footer.astro";
import { ANALYTICS, SITE } from "@constants/index.ts";
import { isPreviewBuild } from "@libs/env.ts";
import "@styles/global.css";

interface Props {
  Meta: {
    title: string;
    description?: string | null;
    image?: string | URL | null;
    ogType?: string;
    noindex?: boolean | null;
  };
}

const siteTitle = SITE.title;
const siteDescription = SITE.description;
// canonical は常に本番のドメイン（astro.config.mjs の site）。プレビューや workers.dev で開いても変わらない
const url = new URL(Astro.url.pathname, Astro.site);
const isHome = Astro.url.pathname === "/";
const { Meta } = Astro.props;
const pageTitle = isHome ? siteTitle : `${Meta.title} | ${siteTitle}`;
const pageDescription = Meta.description ? Meta.description : siteDescription;
const ogImage = new URL(Meta.image ? Meta.image : "/images/og.png", Astro.site);
const ogType = Meta.ogType ? Meta.ogType : "website";
// SITE.noindex は全ページ、Meta.noindex はそのページだけ、isPreviewBuild はプレビューのビルド（docs/site.md の「プレビュー」）
const noindex = SITE.noindex || Meta.noindex || isPreviewBuild;
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    {
      /* アイコン（docs/design.md の「画像・アイコン」）。iPhone は SVG を使わないため、ホーム画面用に PNG も置く */
    }
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    {/* テーマの色（background の白。CSS の変数は使えないため値を直接書く） */}
    <meta name="theme-color" content="#ffffff" />
    <meta name="generator" content={Astro.generator} />
    {
      /* スクリプトが動くときだけ、画面に入ったら出す要素（data-reveal）を最初に隠す（docs/design.md の「動き」）。描画の前に付けるため head に置く */
    }
    <script is:inline>
      document.documentElement.classList.add("js");
    </script>
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Jost:wght@300;400;600&family=Zen+Kaku+Gothic+Antique:wght@400;500;700&display=swap"
      rel="stylesheet"
    />
    <!-- OG settings -->
    <meta property="og:site_name" content={siteTitle} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={url} />
    <meta property="og:type" content={ogType} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage} />
    <link rel="canonical" href={url} />
    {
      /* Search Console の所有権の確認（docs/analytics.md）。値が空のあいだは出さない */
    }
    {
      ANALYTICS.googleSiteVerification && (
        <meta
          name="google-site-verification"
          content={ANALYTICS.googleSiteVerification}
        />
      )
    }
    {
      /*
      Google アナリティクス 4（docs/site.md の「アクセス解析」）。
      本番のドメイン（astro.config.mjs の site）で開いたときだけ計測する（手元の確認や workers.dev のアクセスを混ぜないため）
    */
    }
    <script
      is:inline
      define:vars={{
        measurementId: ANALYTICS.ga4MeasurementId,
        productionHost: Astro.site?.hostname ?? "",
      }}
    >
      // 測定ID が空のあいだは計測しない
      if (measurementId && location.hostname === productionHost) {
        window.dataLayer = window.dataLayer || [];
        window.gtag = function () {
          window.dataLayer.push(arguments);
        };
        window.gtag("js", new Date());
        window.gtag("config", measurementId);
        const script = document.createElement("script");
        script.async = true;
        script.src =
          "https://www.googletagmanager.com/gtag/js?id=" + measurementId;
        document.head.appendChild(script);
      }
    </script>
    {
      /* ページごとに head へ足すもの（例: TOP の構造化データ）。<Fragment slot="head"> で渡す */
    }
    <slot name="head" />
  </head>
  <body>
    {/* ヘッダーは画面の上に固定。ページの中身は各ページが container-page で幅をそろえる（docs/design.md の「レイアウト」） */}
    <Header />
    <main class="min-h-[60vh]">
      <slot />
    </main>
    <Footer />
    <script>
      // data-reveal の要素を、画面に入ったら is-revealed を付けて出し、画面の外に出たら外す（docs/design.md の「動き」）
      // 外してあるので、スクロールして戻ってきたときにもう一度動く。同時に入った要素は、上から順に 0.08 秒ずつ遅らせる
      const targets = document.querySelectorAll<HTMLElement>("[data-reveal]");
      if ("IntersectionObserver" in window) {
        // 出す: 画面の下から 10% 入ったところで
        const showObserver = new IntersectionObserver(
          (entries) => {
            entries
              .filter((entry) => entry.isIntersecting)
              .forEach((entry, index) => {
                const target = entry.target as HTMLElement;
                target.style.setProperty("--reveal-delay", `${index * 80}ms`);
                target.classList.add("is-revealed");
              });
          },
          { rootMargin: "0px 0px -10% 0px" }
        );
        // 戻す: 画面から完全に出たときだけ（見えている間に消えないように）
        const hideObserver = new IntersectionObserver((entries) => {
          entries
            .filter((entry) => !entry.isIntersecting)
            .forEach((entry) => entry.target.classList.remove("is-revealed"));
        });
        targets.forEach((target) => {
          showObserver.observe(target);
          hideObserver.observe(target);
        });
      } else {
        targets.forEach((target) => target.classList.add("is-revealed"));
      }
    </script>
  </body>
</html>
