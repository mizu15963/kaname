---
// PC 幅の左側（中央の表示領域の外）。キャッチコピー・メニューのリンク（ロゴはヘッダーにあるので置かない）（仕様: docs/design.md の「レイアウト」）
// スマホ・タブレット幅では出さない（同じリンクはヘッダーのメニューにある）
import { NAV, SITE } from "@constants/index.ts";
---

{/* 大きい画面では左右の余白だけが広がって小さく見えるので、文字・ボタン・余白をまとめて拡大する（1536px 以上で 1.2 倍、1920px 以上で 1.4 倍） */}
<div class="w-full max-w-xs min-[1536px]:[zoom:1.2] min-[1920px]:[zoom:1.4]">
  <p class="text-3xl leading-snug font-black tracking-tight">
    <span
      class="bg-[linear-gradient(transparent_55%,var(--color-highlight)_55%)]"
      >{SITE.catchphrase}</span
    >
  </p>
  <ul class="mt-10 space-y-2">
    {
      NAV.main.map((item) => (
        <li>
          {/* 右に矢印。ホバーで全体が水色になり、矢印が右に動く */}
          <a
            href={item.href}
            class="group flex items-center gap-3 rounded-button border-2 border-primary bg-background py-3 pr-5 pl-5 font-bold hover:bg-highlight"
          >
            {item.label}
            <span
              class="ml-auto transition-transform group-hover:translate-x-1"
              aria-hidden="true"
            >
              →
            </span>
          </a>
        </li>
      ))
    }
  </ul>
</div>
