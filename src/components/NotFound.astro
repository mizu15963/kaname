---
// ページが見つからないとき（404）
import MoreLink from "@components/MoreLink.astro";
---

<div class="container-page pt-14 pb-24 lg:pt-36 lg:pb-40">
  <p class="font-en text-[56px] leading-none font-light text-primary lg:text-[96px]">404</p>
  <h1 class="mt-6 text-[22px] font-bold lg:text-3xl">ページが見つかりません</h1>
  <p class="mt-4 max-w-[36em] text-muted-foreground">
    お探しのページは、移動または削除された可能性があります。
  </p>
  <MoreLink href="/" class="mt-10">BACK TO TOP</MoreLink>
</div>
