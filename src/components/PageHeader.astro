---
// 下層ページの冒頭（参考サイトの会社情報ページと同じく、左寄せで英字の小見出し → 和文のタイトル → パンくず）
// 仕様: docs/design.md の「下層ページ」
import Breadcrumb from "@components/Breadcrumb.astro";

interface Props {
  // 英字の小見出し（例: Company Profile）
  en: string;
  // 和文のタイトル（h1）
  title: string;
  // 冒頭の下に敷く横長の画像（任意。public/images/parts/ のファイル名から .webp を除いたもの）
  image?: string;
}
const { en, title, image } = Astro.props;
---

<div class="container-page pt-14 lg:pt-36">
  <p data-reveal class="font-en text-sm tracking-[0.1em] text-primary lg:text-xl">{en}</p>
  <h1 data-reveal class="mt-3 text-[28px] leading-[1.3] font-bold lg:mt-5 lg:text-5xl">
    {title}
  </h1>
  <div class="mt-6 lg:mt-10">
    <Breadcrumb items={[{ name: "TOP", url: "/" }, { name: title }]} />
  </div>
  <slot />
</div>
{
  image && (
    <div class="container-page mt-10 lg:mt-16">
      <img
        src={`/images/parts/${image}.webp`}
        srcset={`/images/parts/${image}-800.webp 800w, /images/parts/${image}.webp 1600w`}
        sizes="(min-width: 1200px) 1120px, 100vw"
        alt=""
        width="1600"
        height="800"
        class="aspect-[2/1] w-full rounded-box object-cover lg:aspect-[3/1]"
      />
    </div>
  )
}
