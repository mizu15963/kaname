---
// ハブページ（カテゴリ）のアイコン。線の色は文字の色（currentColor）
// TODO(仕様): カテゴリが決まったら、カテゴリごとのアイコンを足す（ないカテゴリは丸のアイコン）
interface Props {
  id: string;
  class?: string;
}
const { id, class: className } = Astro.props;
---

<svg
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  data-id={id}
  class={className}
>
  <circle cx="12" cy="12" r="9" />
  <path d="m10 8 4 4-4 4" />
</svg>
