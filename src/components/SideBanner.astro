---
// PC 幅の右側（中央の表示領域の外）のバナー（仕様: docs/design.md の「レイアウト」）
// スマホ・タブレット幅では出さない。TODO(仕様): 中身が決まったら差し替える
import { CONTACT } from "@constants/index.ts";
---

{/* 大きい画面では左右の余白だけが広がって小さく見えるので、文字・ボタン・余白をまとめて拡大する（1536px 以上で 1.2 倍、1920px 以上で 1.4 倍） */}
<div class="w-full max-w-xs min-[1536px]:[zoom:1.2] min-[1920px]:[zoom:1.4] space-y-4">
  <a
    href={CONTACT.path}
    class="block rounded-box bg-primary p-7 text-white hover:bg-primary-hover"
  >
    <p class="text-2xl leading-snug font-black">バナーの見出し（仮）</p>
    <p class="mt-3 text-sm leading-relaxed text-white/70">バナーの説明（仮）。</p>
    <span class="mt-6 inline-block text-sm font-bold underline">お問い合わせ →</span>
  </a>
</div>
