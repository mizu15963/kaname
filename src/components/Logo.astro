---
// ロゴ（TODO(仕様): ロゴの画像が届くまで社名の文字を出す。画像にしたら public/images/logo.png・logo-white.png を置き、<img> に替える）（docs/design.md の「画像・アイコン」）
import { SITE } from "@constants/index.ts";

interface Props {
  // 濃紺の地の上に置くとき（フッター）
  inverted?: boolean;
  class?: string;
}
const { inverted = false, class: className } = Astro.props;
---

<span
  class:list={[
    "inline-block text-lg leading-none font-bold tracking-[0.08em] lg:text-xl",
    inverted ? "text-on-primary" : "text-foreground",
    className,
  ]}>{SITE.title}</span
>
