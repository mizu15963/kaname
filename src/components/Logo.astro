---
// ロゴ（docs/design.md の「画像・アイコン」）。白地用の logo.png と、濃紺の地（フッター）用の白抜き logo-white.png
// 画像は高さ 120px の透過 PNG（表示の約3倍）。横幅は width・height の比で決まる
import { SITE } from "@constants/index.ts";

interface Props {
  // 濃紺の地の上に置くとき（フッター）
  inverted?: boolean;
  class?: string;
}
const { inverted = false, class: className } = Astro.props;
---

<img
  src={inverted ? "/images/logo-white.png" : "/images/logo.png"}
  alt={SITE.title}
  width="741"
  height="120"
  class:list={["block h-7 w-auto lg:h-9", className]}
/>
