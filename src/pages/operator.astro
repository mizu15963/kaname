---
// 運営者情報（仕様: docs/site.md の「固定ページ」）。TODO(仕様): 運営者の情報と本文を差し替える
import Layout from "@layouts/Layout.astro";
import PageHeader from "@components/PageHeader.astro";
import Breadcrumb from "@components/Breadcrumb.astro";
import { CONTACT, SITE } from "@constants/index.ts";
const SITE_URL = (Astro.site ?? new URL(Astro.url.origin)).href;
export const prerender = true;

const Meta = {
  title: "運営者情報",
  description: `${SITE.title}の運営者情報です。`,
};

const profile = [
  { label: "サイト名", value: SITE.title },
  { label: "運営者代表", value: "運営者名（仮）" },
  { label: "サイトURL", value: SITE_URL },
  // href がある行は値をリンクにする
  {
    label: "お問い合わせ",
    value: "お問い合わせフォームより受け付けています",
    href: CONTACT.path,
  },
] as { label: string; value: string; href?: string }[];
---

<Layout Meta={Meta} plain>
  <div class="space-y-10">
    <div class="space-y-5">
      <Breadcrumb items={[{ name: "TOP", url: "/" }, { name: "運営者情報" }]} />
      <PageHeader title="運営者情報" />
    </div>

    <dl class="divide-y divide-line rounded-box border-2 border-primary">
      {
        profile.map((row) => (
          <div class="px-4 py-3.5">
            <dt class="text-xs font-bold text-muted-foreground">{row.label}</dt>
            <dd class="mt-1 text-sm break-all">
              {row.href ? (
                <a
                  href={row.href}
                  class="font-bold underline hover:text-link-hover"
                >
                  {row.value}
                </a>
              ) : (
                row.value
              )}
            </dd>
          </div>
        ))
      }
    </dl>

    <section class="space-y-3">
      <h2 class="text-xl font-black">サイトについて</h2>
      <p class="text-[0.95rem] leading-loose">
        {SITE.title}は、〇〇について解説する情報サイトです。（仮の文）
      </p>
    </section>

    <section class="space-y-3 rounded-box bg-section p-5">
      <h2 class="text-lg font-black">ご注意</h2>
      <ul class="list-disc space-y-2 pl-5 text-sm leading-relaxed">
        <li>
          アフィリエイトプログラムで商品やサービスを紹介していますが、商品の販売・発送・代金の受け取りは行っていません。商品についてのご質問は、販売元・提供元へお問い合わせください。
        </li>
        <li>サイト内の文章・画像の無断転載・複製はお断りします。</li>
        <li>
          運営者の個人情報は、お問い合わせフォームからご請求があれば、すみやかに開示します。
        </li>
      </ul>
    </section>
  </div>
</Layout>
