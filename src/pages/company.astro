---
// COMPANY（会社概要。制作指示書の 06。形は参考サイトの会社情報ページと同じ2列の表）
import Layout from "@layouts/Layout.astro";
import PageHeader from "@components/PageHeader.astro";
export const prerender = true;

// TODO(仕様): 会社名・代表者・所在地・設立・連絡先は要確認（指示書 06・09）
const profile = [
  { label: "会社名", value: "正式名称（要確認）" },
  { label: "代表者", value: "代表者名（要確認）" },
  { label: "所在地", value: "本店所在地（要確認）" },
  { label: "設立", value: "設立年月（要確認）" },
  { label: "事業内容", value: "営業代行・営業支援事業\n各種ツール・システム販売事業" },
  { label: "連絡先", value: "会社メールアドレス（要確認）" },
];

const Meta = {
  title: "会社概要",
  description: "会社名・所在地・事業内容などの会社概要です。",
};
---

<Layout Meta={Meta}>
  <PageHeader en="Company Profile" title="会社概要" />

  <section class="container-page py-16 lg:py-32">
    <dl data-reveal class="border-t border-line-strong">
      {
        profile.map((row) => (
          <div class="border-b border-line py-5 lg:grid lg:grid-cols-[240px_1fr] lg:gap-10 lg:py-8">
            <dt class="text-sm font-bold lg:text-base">{row.label}</dt>
            <dd class="mt-2 text-[15px] leading-[1.8] whitespace-pre-line lg:mt-0 lg:text-[17px]">{row.value}</dd>
          </div>
        ))
      }
    </dl>
  </section>
</Layout>
